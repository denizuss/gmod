VertexLitGeneric
{
	$basetexture "SSD_LF\aigulette/ger_aigg_silver_col"
	$bumpmap "SSD_LF\aigulette/ger_aigg_silver_nml"

	$envmap "env_cubemap"
	$normalmapalphaenvmapmask 1
	$envmaptint "[0.06 0.06 0.06]"

	$phong 1
	$phongfresnelranges "[0.5 0.75 1]"
	$phongexponent 2
	$phongboost 2.5

	$color2 "[0.80 0.80 0.80]"
}